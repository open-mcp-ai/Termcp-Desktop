+// staleExtensionPeer rejects a direct call through a mount whose extension
+// template has changed or disappeared since the peer was dialled.
+func (s *Server) staleExtensionPeer(h *jrpcHandle, stmt directive.Statement) *envelope.Slot {
+	if h == nil || s.extensions == nil {
+		return nil
 	}
+	key := peerKey(h.sessionID, h.kind, h.index)
+	v, ok := extPeerHandles.Load(key)
+	if !ok {
+		return nil
+	}
+	entry, _ := v.(*extPeerEntry)
+	if entry == nil {
+		return nil
+	}
+	ext, err := s.extensions.Store().Load(entry.name)
+	if err == nil && ext.Fingerprint() == entry.fp {
+		return nil
+	}
+	s.unmountExtPeer(entry.sessionID, entry.name)
+	reason := "was changed"
+	if err != nil {
+		reason = "was removed"
+	}
+	return &envelope.Slot{Code: 409, Headers: map[string]string{
+		"Path": stmt.Path, "Error-Code": "extension_changed",
+	}, Body: fmt.Sprintf("extension %q %s after this peer was mounted. Open the extension again to use its current URL and headers", entry.name, reason)}
 }
 
